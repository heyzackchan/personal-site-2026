---
/*
 * The frame every page sits inside.
 * The screen is split in half: the left panel (pills, tiles, tagline) and the right panel (the page itself).
 *
 * <ClientRouter /> turns on Astro's view transitions. Instead of loading a whole new page,
 * Astro swaps in only what changed, so the left panel can stay put while the right side fades.
 */
import { ClientRouter } from 'astro:transitions';
import LeftPanel from '../components/LeftPanel.astro';
import '../styles/global.css';

interface Props {
  pageTitle: string;
  pageDescription?: string;
}

const defaultDescription = 'Art direction, interaction design and visual design portfolio.';
const { pageTitle, pageDescription = defaultDescription } = Astro.props;

const yourName = 'Your Name';
const isHomePage = pageTitle === 'Home';

// The text shown in the browser tab.
let browserTabTitle = `${pageTitle} · ${yourName}`;
if (isHomePage) {
  browserTabTitle = `${yourName}, Designer`;
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={pageDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- The Inter font, from Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
    />

    <title>{browserTabTitle}</title>
    <ClientRouter />
  </head>

  <body>
    <div class="split-screen">
      <!--
        transition:persist tells Astro to keep this exact element on screen between pages.
        That is why the selected filter pill and the scroll position survive when you click a tile.
      -->
      <aside class="left-half" transition:persist="left-panel">
        <LeftPanel />
      </aside>

      <!-- Each page's content is placed here. transition:animate="fade" fades it in and out. -->
      <main class="right-half" transition:animate="fade">
        <slot />
      </main>

      <!-- Two rows of colour bars in the top right corner. Purely decorative. -->
      <div class="corner-color-bars" aria-hidden="true" transition:persist="corner-color-bars">
        <span class="color-bar color-bar-orange"></span>
        <span class="color-bar color-bar-yellow"></span>
        <span class="color-bar color-bar-sage"></span>
        <span class="color-bar color-bar-green"></span>
        <span class="color-bar color-bar-pink"></span>
        <span class="color-bar color-bar-slate"></span>
      </div>
    </div>
  </body>
</html>

<style>
  .split-screen {
    position: relative;
    display: grid;
    /* Two equal columns. minmax(0, ...) stops wide content from stretching a column. */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    height: 100dvh;
  }

  .left-half {
    min-width: 0;
    min-height: 0;
    border-right: 1px solid var(--color-divider);
  }

  /* The right half scrolls on its own, so the left half never moves. */
  .right-half {
    position: relative;
    min-width: 0;
    min-height: 0;
    overflow-y: auto;
  }

  /*
   * The colour bars sit on a 7 column grid. The narrow first column lets the
   * bottom row start a little further right than the top row, like the reference.
   */
  .corner-color-bars {
    position: absolute;
    top: 0;
    right: 0;
    z-index: 11;
    display: grid;
    grid-template-columns: 2.4vw repeat(6, 1fr);
    grid-template-rows: 1vw 1vw;
    width: 22.5vw;
  }

  /* grid-area is: row start / column start / row end / column end */
  .color-bar-orange {
    grid-area: 1 / 1 / 2 / 3;
    background: #e9b48a;
  }

  .color-bar-yellow {
    grid-area: 1 / 3 / 2 / 5;
    background: #e9ea94;
  }

  .color-bar-sage {
    grid-area: 1 / 5 / 2 / 8;
    background: #c9d8c0;
  }

  .color-bar-green {
    grid-area: 2 / 2 / 3 / 4;
    background: #add08f;
  }

  .color-bar-pink {
    grid-area: 2 / 4 / 3 / 6;
    background: #d99fc8;
  }

  .color-bar-slate {
    grid-area: 2 / 6 / 3 / 8;
    background: #b3bfd8;
  }

  /* Phones: stack the halves on top of each other and let the whole page scroll. */
  @media (max-width: 820px) {
    .split-screen {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto auto;
      height: auto;
    }

    .left-half {
      border-right: 0;
      border-bottom: 1px solid var(--color-divider);
    }

    .right-half {
      overflow: visible;
    }

    .corner-color-bars {
      grid-template-columns: 20px repeat(6, 1fr);
      grid-template-rows: 8px 8px;
      width: 180px;
    }
  }
</style>
