---
import { ClientRouter } from 'astro:transitions';
import Panel from '../components/Panel.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Art direction, interaction design and visual design portfolio.' } = Astro.props;
const fullTitle = title === 'Home' ? 'Your Name, Designer' : `${title} · Your Name`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
    <title>{fullTitle}</title>
    <ClientRouter />
  </head>
  <body>
    <div class="shell">
      <!-- transition:persist keeps the whole left side alive between pages: filter state, hover, no flash -->
      <aside class="side" transition:persist="panel">
        <Panel />
      </aside>
      <main class="content" transition:animate="fade">
        <slot />
      </main>
      <div class="bars" aria-hidden="true" transition:persist="bars">
        <span></span><span></span><span></span>
        <span></span><span></span><span></span>
      </div>
    </div>
  </body>
</html>

<style>
  .shell {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    height: 100dvh;
  }
  .side { border-right: 1px solid var(--line); min-height: 0; min-width: 0; }
  .content { overflow-y: auto; min-height: 0; min-width: 0; position: relative; }

  /* Colour bars in the top right corner */
  .bars {
    position: absolute; top: 0; right: 0; z-index: 11;
    display: grid; grid-template-columns: 2.4vw repeat(6, 1fr); grid-template-rows: 1vw 1vw;
    width: 22.5vw;
  }
  .bars span:nth-child(1) { grid-area: 1 / 1 / 2 / 3; background: #e9b48a; }
  .bars span:nth-child(2) { grid-area: 1 / 3 / 2 / 5; background: #e9ea94; }
  .bars span:nth-child(3) { grid-area: 1 / 5 / 2 / 8; background: #c9d8c0; }
  .bars span:nth-child(4) { grid-area: 2 / 2 / 3 / 4; background: #add08f; }
  .bars span:nth-child(5) { grid-area: 2 / 4 / 3 / 6; background: #d99fc8; }
  .bars span:nth-child(6) { grid-area: 2 / 6 / 3 / 8; background: #b3bfd8; }

  @media (max-width: 820px) {
    .shell { grid-template-columns: minmax(0, 1fr); grid-template-rows: auto auto; height: auto; }
    .side { border-right: 0; border-bottom: 1px solid var(--line); }
    .content { overflow: visible; }
    .bars { width: 180px; grid-template-rows: 8px 8px; grid-template-columns: 20px repeat(6, 1fr); }
  }
</style>
