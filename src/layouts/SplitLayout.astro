---
/*
 * The frame every page sits inside.
 * The screen is split in half: the left panel (pills, tiles, tagline) and the right side (the page itself).
 *
 * <ClientRouter /> turns on Astro's view transitions. Instead of loading a whole new page,
 * Astro swaps in only what changed, so the left panel stays put while the right side fades.
 */
import "@/styles/global.css";
import { ClientRouter } from "astro:transitions";
import BaseHead from "@/components/utility/BaseHead.astro";
import SkipLink from "@/components/global/SkipLink.astro";
import LeftPanel from "@/components/LeftPanel.astro";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

const seo = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <BaseHead {...seo} />
    <ClientRouter />
  </head>

  <body>
    <SkipLink />

    <div class="split-layout">
      <!--
        transition:persist keeps this exact element on screen between pages.
        That is why the chosen filter pill survives when you click a tile.
      -->
      <aside class="split-layout__left" transition:persist="left-panel">
        <LeftPanel />
      </aside>

      <!-- Each page's content goes here. It fades in and out as you move between pages. -->
      <main id="main" tabindex="-1" class="split-layout__right" transition:animate="fade">
        <slot />
      </main>

      <!-- Two rows of colour bars in the top right corner. Purely decorative. -->
      <div class="color-bars" aria-hidden="true" transition:persist="color-bars">
        <span class="color-bars__bar color-bars__bar--orange"></span>
        <span class="color-bars__bar color-bars__bar--yellow"></span>
        <span class="color-bars__bar color-bars__bar--sage"></span>
        <span class="color-bars__bar color-bars__bar--green"></span>
        <span class="color-bars__bar color-bars__bar--pink"></span>
        <span class="color-bars__bar color-bars__bar--periwinkle"></span>
      </div>
    </div>
  </body>
</html>

<style is:global>
  @layer components {
    /* A soft white haze around the edges of the window, like the reference design. */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: 10;
      box-shadow: inset 0 0 7.5rem 2.5rem rgb(255 255 255 / 0.55);
      pointer-events: none;
    }

    /* Phones first: the two halves stack and the whole page scrolls. */
    .split-layout {
      position: relative;
      display: grid;
      grid-template-columns: minmax(0, 1fr);

      /* Tablets and up: two equal halves side by side, each the height of the window. */
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        height: 100svh;
      }
    }

    .split-layout__left {
      min-width: 0;
      /* Lets the left panel size things relative to this half, using cqw units. */
      container-type: inline-size;
      border-bottom: var(--border-width) solid var(--paper-300);

      @media (width >= 48rem) {
        min-height: 0;
        border-bottom: 0;
        border-right: var(--border-width) solid var(--paper-300);
      }
    }

    .split-layout__right {
      position: relative;
      min-width: 0;
      /* Lets the pages inside size things relative to this half, using cqw units. */
      container-type: inline-size;

      /* The right half scrolls on its own, so the left half never moves. */
      @media (width >= 48rem) {
        min-height: 0;
        overflow-y: auto;
      }
    }

    /*
     * The colour bars sit on a 7 column grid. The narrow first column lets the
     * bottom row start a little further right than the top row, like the reference.
     */
    .color-bars {
      position: absolute;
      top: 0;
      right: 0;
      z-index: 11;
      display: grid;
      grid-template-columns: 1.25rem repeat(6, 1fr);
      grid-template-rows: 0.5rem 0.5rem;
      width: 11.25rem;

      @media (width >= 48rem) {
        grid-template-columns: 2.4vw repeat(6, 1fr);
        grid-template-rows: 1vw 1vw;
        width: 22.5vw;
      }
    }

    /* grid-area is: row start / column start / row end / column end */
    .color-bars__bar--orange {
      grid-area: 1 / 1 / 2 / 3;
      background-color: var(--orange-300);
    }

    .color-bars__bar--yellow {
      grid-area: 1 / 3 / 2 / 5;
      background-color: var(--yellow-200);
    }

    .color-bars__bar--sage {
      grid-area: 1 / 5 / 2 / 8;
      background-color: var(--sage-200);
    }

    .color-bars__bar--green {
      grid-area: 2 / 2 / 3 / 4;
      background-color: var(--green-300);
    }

    .color-bars__bar--pink {
      grid-area: 2 / 4 / 3 / 6;
      background-color: var(--pink-300);
    }

    .color-bars__bar--periwinkle {
      grid-area: 2 / 6 / 3 / 8;
      background-color: var(--periwinkle-200);
    }
  }
</style>
