---
/*
 * The home page. This is what shows in the right half when someone first visits.
 * For now it is a placeholder: a blurred pink ring with big text in the middle.
 */
import Shell from '../layouts/Shell.astro';
---
<Shell pageTitle="Home">
  <section class="home-stage">
    <div class="pink-glow-ring" aria-hidden="true"></div>
    <h1 class="home-headline">Content<br />goes<br />here</h1>
  </section>
</Shell>

<style>
  .home-stage {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100%;
    padding: 48px 16px;
    overflow: hidden;
  }

  /*
   * The ring is an oval filled with a radial gradient:
   * pale pink in the middle, strong pink near the edge, then fading to nothing.
   * The blur softens it, and the rotation tilts it like the reference.
   */
  .pink-glow-ring {
    position: absolute;
    width: 26vw;
    aspect-ratio: 0.68;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgb(242 120 236 / 0.28) 72%,
      var(--color-glow-pink) 86%,
      transparent 100%
    );
    filter: blur(1.4vw);
    transform: rotate(24deg);
    animation: slowly-tilt-ring 12s ease-in-out infinite alternate;
  }

  @keyframes slowly-tilt-ring {
    to {
      transform: rotate(34deg) scale(1.05);
    }
  }

  .home-headline {
    position: relative;
    margin: 0;
    font-size: 3.3vw;
    font-weight: 900;
    line-height: 1.22;
    letter-spacing: 0;
    text-align: center;
    text-transform: uppercase;
  }

  @media (max-width: 820px) {
    .home-stage {
      min-height: 70vh;
    }

    .pink-glow-ring {
      width: 52vw;
      filter: blur(14px);
    }

    .home-headline {
      font-size: 34px;
    }
  }
</style>
