---
/*
 * The about page. Replace the text with your own.
 */
import SplitLayout from "@/layouts/SplitLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";

const email = "hello@example.com";
---
<SplitLayout title="About">
  <Section paddingTop="large" gap="4">
    <Heading tag="h1" variant="h2" class="text-transform-uppercase weight-bold">About</Heading>
    <Paragraph variant="large" maxWidth={60}>
      I am a designer working across art direction, interaction design and visual design.
      I help teams find a clear idea, then carry it from a logo all the way to a live website.
    </Paragraph>
    <Paragraph variant="large" maxWidth={60}>
      Replace this text with your story, your clients and how to reach you:
      <a href={`mailto:${email}`}>{email}</a>
    </Paragraph>
  </Section>
</SplitLayout>
