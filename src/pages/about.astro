---
/*
 * The about page. Replace the text with your own.
 */
import Shell from '../layouts/Shell.astro';

const contactEmailAddress = 'hello@example.com';
---
<Shell pageTitle="About">
  <article class="about-page">
    <h1 class="about-heading">About</h1>
    <p>
      I am a designer working across art direction, interaction design and visual design.
      I help teams find a clear idea, then carry it from a logo all the way to a live website.
    </p>
    <p>
      Replace this text with your story, your clients and how to reach you:
      <a href={`mailto:${contactEmailAddress}`}>{contactEmailAddress}</a>
    </p>
  </article>
</Shell>

<style>
  .about-page {
    max-width: 680px;
    padding: 120px clamp(16px, 5vw, 72px) 64px;
  }

  .about-heading {
    margin: 0 0 24px;
    font-size: clamp(40px, 4.5vw, 64px);
    text-transform: uppercase;
  }

  .about-page p {
    font-size: 19px;
  }
</style>
