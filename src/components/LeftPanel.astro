---
/*
 * Everything on the left half of the screen.
 * This panel stays on screen while you move between pages (see Shell.astro).
 */
import DotMatrixText from './DotMatrixText.astro';
import FilterPills from './FilterPills.astro';
import CaseStudyTileGrid from './CaseStudyTileGrid.astro';
---
<div class="left-panel">
  <!-- Three coloured stripes down the far left edge. Purely decorative. -->
  <div class="edge-stripes" aria-hidden="true">
    <span class="edge-stripe edge-stripe-lavender"></span>
    <span class="edge-stripe edge-stripe-blue"></span>
    <span class="edge-stripe edge-stripe-green"></span>
  </div>

  <!-- The dotted name running up the left edge. It also links back to the home page. -->
  <a class="vertical-name-link" href="/" aria-label="Home">
    <DotMatrixText text="Your Name" isVertical class="vertical-name" />
  </a>

  <FilterPills />

  <CaseStudyTileGrid />

  <p class="tagline">
    art direction,<br />
    interaction design,<br />
    visual design
  </p>
</div>

<style>
  .left-panel {
    position: relative;
    display: grid;
    /* Three rows: pills, tile grid, then the tagline pushed to the bottom. */
    grid-template-rows: auto auto 1fr;
    justify-items: center;
    row-gap: 4vw;
    height: 100%;
    padding-top: 7vw;
    padding-right: 4vw;
    padding-left: 6vw;
    overflow: hidden;
  }

  .edge-stripes {
    position: absolute;
    top: 42%;
    bottom: 0;
    left: 0;
    display: flex;
    flex-direction: column;
    width: 1.25vw;
  }

  /* flex-grow sets how tall each stripe is compared to the others. */
  .edge-stripe-lavender {
    flex-grow: 46;
    background: var(--color-stripe-lavender);
  }

  .edge-stripe-blue {
    flex-grow: 15;
    background: var(--color-stripe-blue);
  }

  .edge-stripe-green {
    flex-grow: 15;
    background: var(--color-stripe-green);
  }

  .vertical-name-link {
    position: absolute;
    bottom: 0.4vw;
    left: 1.25vw;
    color: var(--color-dotted-name);
    text-decoration: none;
  }

  .vertical-name-link :global(.vertical-name) {
    display: block;
    width: 3.9vw;
    height: auto;
  }

  .tagline {
    align-self: end;
    justify-self: start;
    margin: 0;
    margin-left: -0.6vw;
    color: var(--color-tagline);
    font-family: var(--font-body);
    font-size: 2.05vw;
    font-weight: 700;
    line-height: 0.97;
    letter-spacing: -0.045em;
  }

  /* Phones: tighter spacing, thinner stripes, and the dotted name is hidden to save room. */
  @media (max-width: 820px) {
    .left-panel {
      row-gap: 24px;
      padding: 56px 16px 24px 28px;
      overflow: visible;
    }

    .edge-stripes {
      top: 0;
      width: 8px;
    }

    .vertical-name-link {
      display: none;
    }

    .tagline {
      margin: 0;
      font-size: 26px;
    }
  }
</style>
