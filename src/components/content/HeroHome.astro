---
/*
 * The big opening block on the home page: a blurred pink ring with large text in the middle.
 * The heading is a prop, so you can change it in Stacki's settings panel without touching code.
 */
import type { HTMLAttributes } from "astro/types";

interface Props extends HTMLAttributes<"section"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The large text in the middle. Each word sits on its own line. */
  heading?: string;
}

const { render = true, heading = "Content goes here", class: className, ...rest } = Astro.props;
---
{render && heading && (
  <section class:list={["hero-home", className]} {...rest}>
    <div class="hero-home__glow" aria-hidden="true"></div>
    <h1 class="hero-home__heading">{heading}</h1>
  </section>
)}

<style is:global>
  @layer components {
    .hero-home {
      position: relative;
      display: grid;
      place-items: center;
      min-height: 70svh;
      padding: var(--space-8) var(--site-margin);
      overflow: hidden;

      @media (width >= 48rem) {
        min-height: 100%;
      }
    }

    /*
     * The ring is an oval filled with a radial gradient:
     * pale pink in the middle, strong pink near the edge, then fading out.
     * The blur softens it, and the rotation tilts it like the reference.
     * Sizes use cqw, a percentage of the right half's width.
     */
    .hero-home__glow {
      position: absolute;
      width: 52cqw;
      aspect-ratio: 0.68;
      border-radius: 50%;
      background: radial-gradient(
        closest-side,
        rgb(242 120 236 / 0.28) 72%,
        var(--pink-glow) 86%,
        transparent 100%
      );
      filter: blur(2.8cqw);
      transform: rotate(24deg);
      animation: hero-home-tilt 12s ease-in-out infinite alternate;
    }

    .hero-home__heading {
      position: relative;
      /* min-content makes the box as narrow as the longest word, so each word wraps onto its own line. */
      width: min-content;
      font-size: clamp(2.125rem, 6.6cqw, 5rem);
      font-weight: 900;
      line-height: 1.22;
      text-align: center;
      text-transform: uppercase;
    }

    /* A slow, gentle sway. Turned off for people who ask for less motion (see base.css). */
    @keyframes hero-home-tilt {
      to {
        transform: rotate(34deg) scale(1.05);
      }
    }
  }
</style>
