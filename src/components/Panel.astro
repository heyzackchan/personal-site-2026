---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import DotType from './DotType.astro';

const SLOTS = 9; // The grid always shows 3x3. Empty slots wait for future work.
const work = (await getCollection('work', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const filters = [
  { id: 'interactions', label: 'Interactions' },
  { id: 'studies', label: 'Studies' },
  { id: 'clients', label: 'Clients' },
];
---
<div class="panel">
  <div class="stripes" aria-hidden="true"><span></span><span></span><span></span></div>
  <a href="/" class="mark" aria-label="Home">
    <DotType text="Your Name" vertical class="dots" />
  </a>

  <div class="pills" role="group" aria-label="Filter work">
    {filters.map((f) => (
      <button type="button" class="pill" data-filter={f.id} aria-pressed="false">
        <span class="knob" aria-hidden="true"></span>{f.label}
      </button>
    ))}
  </div>

  <ul class="grid" role="list">
    {work.map((entry) => (
      <li data-category={entry.data.category}>
        <a class="tile" href={`/work/${entry.id}/`} data-tile style={`--accent:${entry.data.accent}`}>
          <Image src={entry.data.cover} alt="" widths={[240, 480]} sizes="(max-width: 820px) 30vw, 210px" loading="eager" />
          <span class="tile-title">{entry.data.title}</span>
        </a>
      </li>
    ))}
    {Array.from({ length: Math.max(0, SLOTS - work.length) }).map(() => (
      <li class="empty" aria-hidden="true"><span class="tile"></span></li>
    ))}
  </ul>

  <p class="tagline">art direction,<br />interaction design,<br />visual design</p>
</div>

<script>
  // The panel is persisted across pages. Filter state lives here and survives navigation.
  let active: string | null = null;

  function applyFilter() {
    document.querySelectorAll<HTMLButtonElement>('.pill').forEach((b) =>
      b.setAttribute('aria-pressed', String(b.dataset.filter === active)));
    document.querySelectorAll<HTMLLIElement>('.grid li[data-category]').forEach((li) => {
      li.classList.toggle('dim', active !== null && li.dataset.category !== active);
    });
  }

  function markActive() {
    const here = location.pathname.replace(/\/?$/, '/');
    document.querySelectorAll<HTMLAnchorElement>('[data-tile]').forEach((a) => {
      const target = new URL(a.href).pathname.replace(/\/?$/, '/');
      if (target === here) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  }

  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLButtonElement>('.pill').forEach((b) => {
      if (b.dataset.bound) return;
      b.dataset.bound = '1';
      b.addEventListener('click', () => {
        active = active === b.dataset.filter ? null : (b.dataset.filter ?? null);
        applyFilter();
      });
    });
    applyFilter();
    markActive();
  });
</script>

<style>
  .panel {
    position: relative;
    height: 100%;
    display: grid;
    grid-template-rows: auto auto 1fr;
    justify-items: center;
    padding: 7vw 4vw 0 6vw;
    row-gap: 4vw;
    overflow: hidden;
  }

  /* Colour stripes on the far left edge */
  .stripes { position: absolute; left: 0; top: 42%; bottom: 0; width: 1.25vw; display: flex; flex-direction: column; }
  .stripes span:nth-child(1) { flex: 46; background: var(--stripe-1); }
  .stripes span:nth-child(2) { flex: 15; background: var(--stripe-2); }
  .stripes span:nth-child(3) { flex: 15; background: var(--stripe-3); }

  /* Vertical dot lettering, reads bottom to top */
  .mark { position: absolute; left: 1.25vw; bottom: 0.4vw; color: var(--dots); text-decoration: none; }
  .mark :global(.dots) { display: block; width: 3.9vw; height: auto; }

  .pills { display: flex; gap: 0.7vw; justify-content: center; }
  .pill {
    display: inline-flex; align-items: center; gap: 10px;
    font: 500 clamp(10px, 1vw, 16px)/1 var(--font-sans);
    letter-spacing: 0.04em; text-transform: uppercase;
    color: var(--ink);
    background: var(--pill);
    border: 1.5px solid var(--pill-line);
    border-radius: 999px;
    padding: 0.5em 0.75em;
    cursor: pointer;
    transition: background 0.25s ease, padding 0.25s ease;
  }
  .knob { width: 0; height: 1.25em; border-radius: 50%; background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.15); transition: width 0.25s ease; margin-left: -0.6em; }
  .pill[aria-pressed='true'] { background: linear-gradient(90deg, var(--pill-on) 0 2.85em, var(--pill) 2.85em); padding-left: 0.55em; }
  .pill[aria-pressed='true'] .knob { width: 1.25em; margin-left: 0; margin-right: 0.9em; }

  .grid {
    list-style: none; margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 10.3vw);
    gap: 0.9vw;
    width: 100%;
    justify-content: center;
  }
  .grid li { aspect-ratio: 205 / 211; transition: opacity 0.3s ease, filter 0.3s ease; }
  .grid li.dim { opacity: 0.25; filter: grayscale(1); }
  .tile {
    position: relative; display: block; height: 100%;
    border-radius: 1.3vw;
    background: var(--tile);
    border: 1.5px solid var(--tile-line);
    box-shadow: inset 0 0 1.1vw var(--tile-glow);
    overflow: hidden;
    text-decoration: none;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  a.tile { background: var(--accent); }
  a.tile :global(img) { width: 100%; height: 100%; object-fit: cover; }
  a.tile::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 22px rgb(0 0 0 / 0.18); pointer-events: none; }
  a.tile:hover { transform: translateY(-3px); }
  a.tile[aria-current='page'] { box-shadow: 0 0 0 3px var(--bg), 0 0 0 5px var(--ink); }
  .tile-title {
    position: absolute; inset: auto 0 0 0; padding: 28px 14px 12px;
    color: #fff; font-size: 13px; font-weight: 600; letter-spacing: 0.02em;
    background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
    opacity: 0; transform: translateY(6px); transition: opacity 0.25s ease, transform 0.25s ease;
  }
  a.tile:hover .tile-title, a.tile:focus-visible .tile-title, a.tile[aria-current='page'] .tile-title { opacity: 1; transform: none; }

  .tagline {
    justify-self: start;
    align-self: end;
    margin: 0 0 0 -0.6vw;
    font: 700 2.05vw/0.97 var(--font-sans);
    letter-spacing: -0.045em;
    color: var(--tagline);
  }

  @media (max-width: 820px) {
    .panel { padding: 56px 16px 24px 28px; row-gap: 24px; overflow: visible; }
    .stripes { top: 0; width: 8px; }
    .pills { gap: 8px; }
    .pill { font-size: 12px; }
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
    .mark { left: 14px; }
    .mark { display: none; }
    .tile { border-radius: 16px; }
    .tagline { font-size: 26px; margin: 0; }
  }
</style>
