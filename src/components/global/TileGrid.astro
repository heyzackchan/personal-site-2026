---
/*
 * The 3 by 3 grid of tiles on the left side.
 * Case studies fill the first tiles. Plain sage tiles fill the rest, so the grid always stays 3 by 3.
 */
import Img from "@/components/media/Img.astro";
import { getCaseStudies, getLink } from "@/utils/case-studies.ts";

const gridSize = 9;

const caseStudies = await getCaseStudies();
const emptyCount = Math.max(0, gridSize - caseStudies.length);
const emptyTiles = Array.from({ length: emptyCount });
---
<ul class="tile-grid" role="list">
  {caseStudies.map((caseStudy) => (
    <li class="tile-grid__cell" data-category={caseStudy.data.category}>
      <a
        class="tile-grid__tile tile-grid__tile--link"
        href={getLink(caseStudy)}
        style={`--_tile-color: ${caseStudy.data.tileColor}`}
      >
        <Img
          src={caseStudy.data.coverImage}
          variant="constrained"
          width={240}
          height={247}
          sizes="(width >= 48rem) 22vw, 30vw"
          loading="eager"
          class="height-full"
        />
        <span class="tile-grid__title">{caseStudy.data.title}</span>
      </a>
    </li>
  ))}

  {emptyTiles.map(() => (
    <li class="tile-grid__cell" aria-hidden="true">
      <span class="tile-grid__tile"></span>
    </li>
  ))}
</ul>

<script>
  /*
   * Mark the tile for the case study you are looking at, so CSS can outline it.
   * The grid stays on screen between pages, so this runs after every page change.
   */
  function withSlash(path: string): string {
    if (path.endsWith("/")) {
      return path;
    }
    return path + "/";
  }

  function markCurrent() {
    const currentPath = withSlash(window.location.pathname);

    document.querySelectorAll<HTMLAnchorElement>(".tile-grid__tile--link").forEach((link) => {
      const linkPath = withSlash(new URL(link.href).pathname);
      if (linkPath === currentPath) {
        // aria-current tells screen readers this is the page you are on. The CSS uses it for the outline.
        link.setAttribute("aria-current", "page");
      } else {
        link.removeAttribute("aria-current");
      }
    });
  }

  document.addEventListener("astro:page-load", markCurrent);
</script>

<style is:global>
  @layer components {
    .tile-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 0.625rem;
      width: 100%;

      @media (width >= 48rem) {
        grid-template-columns: repeat(3, 20.6cqw);
        justify-content: center;
        gap: 1.8cqw;
      }
    }

    .tile-grid__cell {
      aspect-ratio: 205 / 211;
      transition:
        opacity 300ms var(--hover-ease),
        filter 300ms var(--hover-ease);
    }

    /* Set by FilterPills.astro when a different category is switched on. */
    .tile-grid__cell--faded {
      opacity: 0.25;
      filter: grayscale(1);
    }

    .tile-grid__tile {
      position: relative;
      display: block;
      height: 100%;
      overflow: hidden;
      border: 0.09375rem solid var(--sage-400);
      border-radius: var(--radius-main);
      background-color: var(--sage-300);
      box-shadow: inset 0 0 1.375rem var(--sage-glow);
      transition:
        transform var(--hover-duration) var(--hover-ease),
        box-shadow var(--hover-duration) var(--hover-ease);

      @media (width >= 48rem) {
        border-radius: 2.6cqw;
        box-shadow: inset 0 0 2.2cqw var(--sage-glow);
      }
    }

    /* A tile that links to a case study, filled with its cover image. */
    .tile-grid__tile--link {
      background-color: var(--_tile-color);

      /* A soft shadow on the inside edge, so image tiles match the empty sage tiles. */
      &::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        box-shadow: inset 0 0 1.375rem rgb(0 0 0 / 0.18);
        pointer-events: none;
      }

      @media (hover: hover) {
        &:hover {
          transform: translateY(-0.1875rem);
        }
      }

      &[aria-current="page"] {
        box-shadow:
          0 0 0 0.1875rem var(--background),
          0 0 0 0.3125rem var(--text);
      }
    }

    /* The project name. Hidden until you hover the tile, or while you are on that project's page. */
    .tile-grid__title {
      position: absolute;
      inset: auto 0 0 0;
      padding: 1.75rem 0.875rem 0.75rem;
      background: linear-gradient(transparent, rgb(0 0 0 / 0.55));
      color: var(--light-100);
      font-size: 0.8125rem;
      font-weight: var(--primary-bold);
      letter-spacing: 0.02em;
      opacity: 0;
      transform: translateY(0.375rem);
      transition:
        opacity var(--hover-duration) var(--hover-ease),
        transform var(--hover-duration) var(--hover-ease);

      .tile-grid__tile--link:hover &,
      .tile-grid__tile--link:focus-visible &,
      .tile-grid__tile--link[aria-current="page"] & {
        opacity: 1;
        transform: none;
      }
    }
  }
</style>
